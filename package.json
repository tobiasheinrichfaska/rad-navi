{
  "name": "rad-navi",
  "version": "0.1.1",
  "description": "Wheel navigation (two coupled friction wheels): UI-free geometry and logic",
  "type": "module",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "tsc -p tsconfig.build.json && node scripts/fix-declarations.mjs",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": "false",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ]
}
